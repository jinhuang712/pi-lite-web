{
	"name": "pi-lite-web",
	"version": "0.2.0",
	"description": "Two compact, keyless web tools for Pi: search and fetch. No SDK, no API key, bounded context cost.",
	"private": true,
	"type": "module",
	"license": "MIT",
	"keywords": ["pi-package", "pi-extension", "pi", "web-search", "web-fetch"],
	"files": ["src", "README.md", "CHANGELOG.md", "LICENSE"],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jinhuang712/pi-lite-web.git"
	},
	"bugs": {
		"url": "https://github.com/jinhuang712/pi-lite-web/issues"
	},
	"homepage": "https://github.com/jinhuang712/pi-lite-web#readme",
	"engines": {
		"node": ">=22.19.0"
	},
	"pi": {
		"extensions": ["./src/index.ts"]
	},
	"scripts": {
		"test": "node --test --experimental-strip-types test/*.test.ts",
		"typecheck": "tsc --noEmit"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*",
		"typebox": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "0.85.1",
		"@earendil-works/pi-tui": "0.85.1",
		"@types/node": "^22.20.2",
		"typebox": "1.3.30",
		"typescript": "7.0.2"
	}
}
